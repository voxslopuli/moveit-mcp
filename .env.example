# envsitter: MoveIT account password for API authentication
MOVEIT_PASSWORD=
# envsitter: Base URL of the MoveIT server, e.g. https://moveit.example.com
MOVEIT_BASE_URL=
# envsitter: MoveIT account username for API authentication
MOVEIT_USERNAME=
# envsitter: MoveIT server hostname (used when different from the base URL host)
MOVEIT_SERVER_HOST=
# envsitter: Set to 0 to disable TLS certificate validation (self-signed certs); leave empty for strict validation
MOVEIT_TLS_REJECT_UNAUTHORIZED=
# envsitter: Path to a PEM CA bundle file for custom/enterprise CAs (keeps TLS verification strict)
MOVEIT_CA_FILE=
