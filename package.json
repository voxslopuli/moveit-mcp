{
  "name": "@voxslopuli/moveit-mcp",
  "version": "0.2.1",
  "homepage": "https://github.com/voxslopuli/moveit-mcp#readme",
  "bugs": "https://github.com/voxslopuli/moveit-mcp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voxslopuli/moveit-mcp.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "moveit-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "audit:fallow": "fallow audit --dead-code-baseline fallow-baselines/dead-code.json --health-baseline fallow-baselines/health.json --dupes-baseline fallow-baselines/dupes.json",
    "build": "tsup",
    "check": "ultracite check",
    "dev": "tsx src/index.ts",
    "fix": "ultracite fix",
    "format": "biome check --write .",
    "lint": "biome check .",
    "prepare": "husky",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "biome check --write"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "fallow": "^3.43.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "ultracite": "^8.2.1",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
