{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/vitest"],
  "files": {
    "includes": [
      "!node_modules",
      "!dist",
      "!docs",
      "!CHANGELOG.md",
      "!.fallow",
      "!.fallowrc.json",
      "!fallow-baselines"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": ["tests/**"],
      "linter": {
        "rules": {
          "performance": {
            "useTopLevelRegex": "off"
          },
          "suspicious": {
            "useAwait": "off",
            "noReturnAssign": "off",
            "noConditionalExpect": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "style": {
            "useNamedCaptureGroup": "off"
          }
        }
      }
    }
  ]
}
